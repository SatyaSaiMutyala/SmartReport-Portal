PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/smartreport
CLIENT_URL=http://localhost:5173

# Optional: public DNS for mongodb+srv lookups if local DNS refuses SRV queries
# DNS_SERVERS=8.8.8.8,1.1.1.1

# TrustLab LIMS (ITDOSE) — Smart Report data source
LIMS_BASE_URL=https://mytrustlab.in/Trustlab
# Must equal the contents of <LIMS>/App_Data/smartreport-history.key (GetPatientHistory.aspx)
LIMS_HISTORY_KEY=
